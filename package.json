{
  "name": "discord-botlists",
  "version": "1.0.0",
  "description": "Universal multi-botlist SDK for Discord bots: post stats to 30+ verified live lists, realtime vote webhooks, ratings and a universal data parser with full TypeScript types",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks/server.d.ts",
      "import": "./dist/webhooks/server.js",
      "require": "./dist/webhooks/server.js"
    },
    "./lists": {
      "types": "./dist/data/lists.d.ts",
      "import": "./dist/data/lists.js",
      "require": "./dist/data/lists.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "test": "bun test test/",
    "test:node": "node --test test/node/",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "discord-botlists",
    "discord botlist",
    "botlist",
    "top.gg",
    "topgg",
    "discordbotlist",
    "votes",
    "vote webhook",
    "discord.js",
    "eris",
    "stats poster",
    "botblock",
    "discord"
  ],
  "author": "PotenFYR Studios",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PotenFYR-Studios/discord-botlists.git"
  },
  "bugs": {
    "url": "https://github.com/PotenFYR-Studios/discord-botlists/issues"
  },
  "homepage": "https://potenfyr.in",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "bun-types": "^1.4.2",
    "typescript": "^5.9.3"
  }
}
