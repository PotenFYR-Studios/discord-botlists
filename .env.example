# discord-botlists test tokens
# copy this file to .env and fill in what you have. every entry is optional:
# the live test only exercises lists you provided tokens for.
#
# run: bun run test:live

# the discord user/bot id used for public fetch tests
DBL_TEST_BOT_ID=

# fake server count used for post tests
DBL_TEST_SERVER_COUNT=1

# ==== list tokens (env key = DBL_ + list id uppercased) ====
